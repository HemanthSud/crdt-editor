# WebSocket origin for the CRDT relay server. Defaults to ws://localhost:8787
# when unset, which is what `cargo run -p server` serves locally.
#
# In production this MUST be wss:// - an HTTPS page is not allowed to open a
# plaintext ws:// connection (mixed content), and the browser will block it.
VITE_WS_URL=ws://localhost:8787
